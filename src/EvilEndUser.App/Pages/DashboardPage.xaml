<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EvilEndUser.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EvilEndUser.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EvilEndUser.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="1100" Spacing="16">

            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Safety banner -->
            <InfoBar
                x:Name="SafetyBanner"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Title="Authorised testing only"
                Message="Run this only on endpoints you are authorised to test. Safe Mode restricts all activity to vetted, harmless Microsoft/EICAR/AMTSO test payloads." />

            <!-- Run controls -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: configuration summary -->
                <Border
                    Grid.Column="0"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Run Profile" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <ComboBox
                            x:Name="PersonaCombo"
                            Header="Persona"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="PersonaCombo_SelectionChanged" />

                        <ComboBox
                            x:Name="RiskCombo"
                            Header="Maximum risk ceiling"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="RiskCombo_SelectionChanged" />

                        <ToggleSwitch
                            x:Name="SafeModeToggle"
                            Header="Safe Mode (vetted payloads only)"
                            OnContent="On"
                            OffContent="Off"
                            Toggled="SafeModeToggle_Toggled" />

                        <ToggleSwitch
                            x:Name="DryRunToggle"
                            Header="Dry run (log actions without executing)"
                            OnContent="On"
                            OffContent="Off"
                            Toggled="DryRunToggle_Toggled" />
                    </StackPanel>
                </Border>

                <!-- Right: status -->
                <Border
                    Grid.Column="1"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Status" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="{x:Bind Sim.IsRunning, Mode=OneWay}" Width="24" Height="24" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Sim.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Sim.EventCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Events" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Sim.RiskyActionCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="#E8B100" />
                                <TextBlock Text="Risky actions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action buttons -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="Quick actions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="KillChainButton" Click="KillChain_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="16" />
                                <TextBlock Text="Run full kill chain" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WanderButton" Click="Wander_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE99A;" FontSize="16" />
                                <TextBlock Text="LLM free roam" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScenariosButton" Click="Scenarios_Click" Content="Browse scenarios" />
                        <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="{x:Bind Sim.IsRunning, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="16" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="LlmHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="LLM free roam requires an Azure OpenAI / OpenAI deployment configured on the Configuration page." />
                </StackPanel>
            </Border>

            <!-- Live feed -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Live activity" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton Content="Open full log" Click="Scenarios_OpenLog" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView
                        x:Name="FeedList"
                        ItemsSource="{x:Bind Sim.Events, Mode=OneWay}"
                        MaxHeight="320"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SimulationEvent">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{x:Bind Severity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TechniqueId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="80" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
